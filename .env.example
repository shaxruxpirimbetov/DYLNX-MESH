# Copy to .env and fill in. Never commit the real .env file.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Required when DEBUG=False: origins allowed to call the API (admin panel domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://user:password@localhost:5432/mesh

# --- Public address of this backend (encoded into every QR code), no trailing slash ---
BACKEND_HERE=http://127.0.0.1:8000

# --- Telegram ---
TELEGRAM_BOT_USERNAME=YourMeshBot      # without @
MESH_BUY_URL=https://example.com/buy   # optional

# --- Cloudflare R2 (QR images) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
